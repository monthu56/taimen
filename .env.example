# Контракт окружения платформы Taimen.
# Скопировать в .env (0600) — `make secrets` делает это и генерирует случайные секреты.
# Одно понятие — одно имя; compose.yml сам раскладывает значения по префиксам сервисов
# (CP_*, IAM_*, CB_*, NS_*).

# ---------------------------------------------------------------- окружение
# Публичный адрес платформы. Он же issuer IAM (${TAIMEN_PUBLIC_URL}/iam) и
# Keycloak (${TAIMEN_PUBLIC_URL}/auth). Локально — taimen.localhost: Chrome и Firefox
# резолвят *.localhost сами; для curl и Safari добавьте в /etc/hosts
# «127.0.0.1 taimen.localhost». Промышленная инсталляция: https://taimen.example.com
TAIMEN_PUBLIC_URL=http://taimen.localhost
TAIMEN_PUBLIC_HOST=taimen.localhost
# Имя compose-проекта и сети.
COMPOSE_PROJECT_NAME=taimen
TAIMEN_NETWORK=taimen_default
# Caddyfile: локальный (http) или свой с доменом и TLS (та же раскладка путей).
CADDYFILE=./deploy/caddy/Caddyfile.local
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
LOG_LEVEL=INFO

# ------------------------------------------------------------------ tenant
# IAM tenant печатает `make bootstrap`; нужен клиентам и раннерам. До bootstrap пуст.
IAM_TENANT_ID=

# ------------------------------------------------------------------- секреты
# make secrets заполняет пустые значения случайными.
CP_POSTGRES_PASSWORD=
IAM_POSTGRES_PASSWORD=
MEMORY_POSTGRES_PASSWORD=
NOTIFY_POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Одноразовые bootstrap-токены (Bearer у Control Plane, X-IAM-Bootstrap-Token у IAM)
CP_BOOTSTRAP_TOKEN=
IAM_BOOTSTRAP_TOKEN=
# Статический ключ памяти: для ядра — только до bootstrap, дальше context-adapter
# ходит service account'ом IAM (см. CP_CONTEXT_AUTH)
MEMORY_API_KEY=
# Keycloak (профиль idp): администратор Admin API
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Локально по http strict hostname выключен; в промышленной инсталляции — true
KEYCLOAK_HOSTNAME_STRICT=false
# MinIO: root-ключи (только minio-bootstrap заводит ими бакет и пользователя ядра)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Содержимое артефактов ядра: свой пользователь MinIO с правами только на бакет.
# Внешний S3 — CP_S3_ENDPOINT_URL и ключи провайдера.
CP_S3_ACCESS_KEY_ID=
CP_S3_SECRET_ACCESS_KEY=
CP_S3_BUCKET=artifacts
#CP_S3_ENDPOINT_URL=http://minio:9000
#CP_S3_REGION=us-east-1
# Ключ подписи IAM: RSA 3072, создаёт make secrets. На Linux владелец файла — uid 10001.
IAM_SIGNING_KEY_FILE=./secrets/iam-signing.pem
IAM_SIGNING_KEY_ID=local-dev

# ---------------------------------------------------------------------- LLM
# Любой OpenAI-совместимый endpoint для памяти (эмбеддинги и реранкер).
# Пусто — память работает офлайн (fake/echo).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Память: fake/echo офлайн или openai. Включать вместе с LLM_BASE_URL и LLM_API_KEY.
MEMORY_EMBEDDING_PROVIDER=fake
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_LLM_PROVIDER=echo
MEMORY_RERANK_ENABLED=false
MEMORY_CONSOLE_ENABLED=false
# Приём IAM-токенов audience memory-service в дополнение к MEMORY_API_KEY
MEMORY_IAM_ENABLED=true

# ------------------------------------------------------------- Control Plane
# IAM-only: legacy api-key не является credential
CP_LEGACY_API_KEYS_ENABLED=false
# Credential ядра к памяти: auto = service account IAM из secrets/control-plane-iam.env
# (создаёт bootstrap), пока файла нет — MEMORY_API_KEY; api_key / iam — принудительно
CP_CONTEXT_AUTH=auto
CP_CORS_ORIGINS=[]
# Администраторы реестра онтологий памяти: JSON-список id principal;
# пусто — POST /api/v1/knowledge/packs отвечает 403
CP_KNOWLEDGE_PACK_ADMINS=[]

# ------------------------------------------------------ notification-service
#NOTIFY_EMAIL_FROM=notifications@example.com
#NOTIFY_SMTP_HOST=smtp.example.com
#NOTIFY_SMTP_PORT=587

# -------------------------------------------------------- порты на 127.0.0.1
# Наружу смотрит только Caddy; bootstrap и make smoke ходят по этим портам.
CP_HOST_PORT=18000
MEMORY_HOST_PORT=18001
IAM_HOST_PORT=18010
NOTIFY_HOST_PORT=18045
KEYCLOAK_HOST_PORT=18081

# --------------------------------------------------------- лимиты памяти
# Значения по умолчанию рассчитаны на машину с 8 ГБ RAM; менять по месту.
#PG_MEM_LIMIT=256m
#CP_MEM_LIMIT=512m
#MEMORY_MEM_LIMIT=512m
#KEYCLOAK_MEM_LIMIT=768m
