# Environment contract of the Taimen platform.
# Copy to .env (0600) — `make secrets` does this and generates random secrets.
# One concept — one name; compose.yml itself maps the values to service prefixes
# (CP_*, IAM_*, CB_*, NS_*).

# ------------------------------------------------------------- environment
# Public address of the platform. It is also the IAM issuer (${TAIMEN_PUBLIC_URL}/iam)
# and Keycloak (${TAIMEN_PUBLIC_URL}/auth). Locally — taimen.localhost: Chrome and
# Firefox resolve *.localhost themselves; for curl and Safari add
# "127.0.0.1 taimen.localhost" to /etc/hosts. Production installation: https://taimen.example.com
TAIMEN_PUBLIC_URL=http://taimen.localhost
TAIMEN_PUBLIC_HOST=taimen.localhost
# Name of the compose project and network.
COMPOSE_PROJECT_NAME=taimen
TAIMEN_NETWORK=taimen_default
# Caddyfile: the local one (http) or your own with a domain and TLS (same path layout).
CADDYFILE=./deploy/caddy/Caddyfile.local
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
LOG_LEVEL=INFO

# ------------------------------------------------------------------ tenant
# The IAM tenant is printed by `make bootstrap`; clients and runners need it. Empty before bootstrap.
IAM_TENANT_ID=

# ----------------------------------------------------------------- secrets
# make secrets fills empty values with random ones.
CP_POSTGRES_PASSWORD=
IAM_POSTGRES_PASSWORD=
MEMORY_POSTGRES_PASSWORD=
NOTIFY_POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# One-time bootstrap tokens (Bearer for the Control Plane, X-IAM-Bootstrap-Token for IAM)
CP_BOOTSTRAP_TOKEN=
IAM_BOOTSTRAP_TOKEN=
# Static memory key: for the core only until bootstrap; after that context-adapter
# uses an IAM service account (see CP_CONTEXT_AUTH)
MEMORY_API_KEY=
# Keycloak (idp profile): Admin API administrator
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Locally over http strict hostname is off; in a production installation — true
KEYCLOAK_HOSTNAME_STRICT=false
# MinIO: root keys (only minio-bootstrap uses them to create the bucket and the core's user)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Contents of the core's artifacts: a dedicated MinIO user with rights to the bucket only.
# External S3 — CP_S3_ENDPOINT_URL and the provider's keys.
CP_S3_ACCESS_KEY_ID=
CP_S3_SECRET_ACCESS_KEY=
CP_S3_BUCKET=artifacts
#CP_S3_ENDPOINT_URL=http://minio:9000
#CP_S3_REGION=us-east-1
# IAM signing key: RSA 3072, created by make secrets. On Linux the file owner is uid 10001.
IAM_SIGNING_KEY_FILE=./secrets/iam-signing.pem
IAM_SIGNING_KEY_ID=local-dev

# --------------------------------------------------------------------- LLM
# Any OpenAI-compatible endpoint for memory (embeddings and reranker).
# Empty — memory works offline (fake/echo).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Memory: fake/echo offline, or openai. Enable together with LLM_BASE_URL and LLM_API_KEY.
MEMORY_EMBEDDING_PROVIDER=fake
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_LLM_PROVIDER=echo
MEMORY_RERANK_ENABLED=false
MEMORY_CONSOLE_ENABLED=false
# Accept IAM tokens of the memory-service audience in addition to MEMORY_API_KEY
MEMORY_IAM_ENABLED=true

# ----------------------------------------------------------- Control Plane
# IAM-only: a legacy api-key is not a credential
CP_LEGACY_API_KEYS_ENABLED=false
# The core's credential for memory: auto = IAM service account from secrets/control-plane-iam.env
# (created by bootstrap), MEMORY_API_KEY while the file is missing; api_key / iam — forced
CP_CONTEXT_AUTH=auto
CP_CORS_ORIGINS=[]
# Administrators of the memory ontology registry: a JSON list of principal ids;
# empty — POST /api/v1/knowledge/packs responds 403
CP_KNOWLEDGE_PACK_ADMINS=[]

# ---------------------------------------------------- notification-service
#NOTIFY_EMAIL_FROM=notifications@example.com
#NOTIFY_SMTP_HOST=smtp.example.com
#NOTIFY_SMTP_PORT=587

# ------------------------------------------------------ ports on 127.0.0.1
# Only Caddy faces the outside; bootstrap and make smoke use these ports.
CP_HOST_PORT=18000
MEMORY_HOST_PORT=18001
IAM_HOST_PORT=18010
NOTIFY_HOST_PORT=18045
KEYCLOAK_HOST_PORT=18081

# ----------------------------------------------------------- memory limits
# The defaults are sized for a machine with 8 GB of RAM; adjust as needed.
#PG_MEM_LIMIT=256m
#CP_MEM_LIMIT=512m
#MEMORY_MEM_LIMIT=512m
#KEYCLOAK_MEM_LIMIT=768m
